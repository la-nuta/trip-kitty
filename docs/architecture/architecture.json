    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "Angular + Signals, mobile-first",
        "Expense table on desktop, cards on phone",
        "PWA: add to home screen without the App Store",
        "Realtime subscription keeps the shared table current",
        "UI in Russian and English: Transloco, formatting via Intl"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server logic",
      "items": [
        "AI calls, financial operations and permission checks run server-side only",
        "Critical changes run in a single transaction",
        "Record version control: no silent overwrites",
        "Idempotent import and confirmations"
      ]
    },
    {
      "dot": "violet",
      "title": "Data",
      "items": [
        "trips, trip_members, invitations",
        "import_batches, receipts, expenses, expense_items",
        "expense_payments and expense_splits are stored independently",
        "settlements, exchange_rates, activity_log",
        "Money as integer minor units or NUMERIC",
        "users stores the UI language; categories and statuses stored as codes, not text"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "RLS on every trip table",
        "Private storage and private document links",
        "File type and size checks",
        "Guests have a stable identity, required to confirm transfers"
      ]
    },
    {
      "dot": "amber",
      "title": "Independent statuses",
      "items": [
        "Recognition: pending / processing / completed / failed",
        "Review: draft / confirmed / rejected",
        "Allocation: unallocated / allocated",
        "Payment: unknown / unpaid / partially_paid / paid",
        "Transfer: pending / sent / confirmed / rejected / cancelled"
      ]
    },
    {
      "dot": "slate",
      "title": "After MVP",
      "items": [
        "Gmail, Google Drive, Telegram bot",
        "Bank CSV import, Open Banking",
        "Wise / Revolut payment links"
      ]
    }
